# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
dist-ssr/
build/
client/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
